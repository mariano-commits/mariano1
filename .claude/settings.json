{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/seo-runtime-setup.sh",
            "timeout": 600
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/skills/seo/hooks/run-python-hook.js \"$CLAUDE_PROJECT_DIR\"/.claude/skills/seo/hooks/validate-schema.py"
          }
        ]
      }
    ]
  }
}
